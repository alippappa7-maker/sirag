rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdminOrOwner() {
      let role = getUserRole();
      return role == 'ADMIN' || role == 'OWNER';
    }

    function getWorkspaceRole(workspaceId) {
      let memberDoc = get(/databases/$(database)/documents/workspace_members/$(workspaceId + '_' + request.auth.uid));
      return memberDoc != null ? memberDoc.data.role : null;
    }

    function hasWorkspaceRole(workspaceId, allowedRoles) {
      return getWorkspaceRole(workspaceId) in allowedRoles || isAdminOrOwner();
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdminOrOwner());
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'credits', 'plan', 'isBanned']);
      allow update: if request.auth != null && isAdminOrOwner() 
                    && (request.resource.data.role != 'OWNER' || getUserRole() == 'OWNER');
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.role == 'USER';
    }
    
    match /audit_logs/{logId} {
      allow read, create: if request.auth != null && isAdminOrOwner();
    }
    
    match /workspaces/{workspaceId} {
      allow read: if request.auth != null && hasWorkspaceRole(workspaceId, ['OWNER', 'MANAGER', 'EDITOR', 'REVIEWER', 'VIEWER']);
      allow create: if request.auth != null;
      allow update: if request.auth != null && hasWorkspaceRole(workspaceId, ['OWNER', 'MANAGER']);
      allow delete: if request.auth != null && hasWorkspaceRole(workspaceId, ['OWNER']);
    }

    match /workspace_members/{memberId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || hasWorkspaceRole(resource.data.workspaceId, ['OWNER', 'MANAGER', 'EDITOR', 'REVIEWER', 'VIEWER']));
      allow create: if request.auth != null && (hasWorkspaceRole(request.resource.data.workspaceId, ['OWNER', 'MANAGER']) || request.auth.uid == request.resource.data.userId);
      allow update, delete: if request.auth != null && hasWorkspaceRole(resource.data.workspaceId, ['OWNER', 'MANAGER']);
    }

    match /workspace_invitations/{invitationId} {
      allow read: if request.auth != null && (request.auth.token.email == resource.data.email || hasWorkspaceRole(resource.data.workspaceId, ['OWNER', 'MANAGER', 'EDITOR', 'REVIEWER', 'VIEWER']));
      allow create: if request.auth != null && hasWorkspaceRole(request.resource.data.workspaceId, ['OWNER', 'MANAGER']);
      allow update, delete: if request.auth != null && (request.auth.token.email == resource.data.email || hasWorkspaceRole(resource.data.workspaceId, ['OWNER', 'MANAGER']));
    }

    match /projects/{projectId} {
      allow read: if request.auth != null && hasWorkspaceRole(resource.data.workspaceId, ['OWNER', 'MANAGER', 'EDITOR', 'REVIEWER', 'VIEWER']);
      allow create: if request.auth != null && hasWorkspaceRole(request.resource.data.workspaceId, ['OWNER', 'MANAGER', 'EDITOR']);
      allow update: if request.auth != null && hasWorkspaceRole(resource.data.workspaceId, ['OWNER', 'MANAGER', 'EDITOR']);
      allow delete: if request.auth != null && hasWorkspaceRole(resource.data.workspaceId, ['OWNER', 'MANAGER']);
    }
    
    match /project_activities/{activityId} {
      allow read, create: if request.auth != null; // Ideally secure with workspace role
    }
    
    match /project_versions/{versionId} {
      allow read, create: if request.auth != null; // Ideally secure with workspace role
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}