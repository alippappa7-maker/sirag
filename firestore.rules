rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth & App Check validation
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Custom claims check
    function hasAdminClaim() {
      return isAuthenticated() && ('role' in request.auth.token) && (request.auth.token.role == 'ADMIN' || request.auth.token.role == 'OWNER');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role-based access from Firestore (Fallback or for Workspace roles)
    function getWorkspaceRole(workspaceId) {
      let memberDoc = get(/databases/$(database)/documents/workspace_members/$(workspaceId + '_' + request.auth.uid));
      return memberDoc != null ? memberDoc.data.role : null;
    }
    
    function hasWorkspaceRole(workspaceId, allowedRoles) {
      return getWorkspaceRole(workspaceId) in allowedRoles || hasAdminClaim();
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || hasAdminClaim();
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'credits', 'plan', 'isBanned', 'entitlements', 'balance']);
      allow update: if hasAdminClaim();
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'USER'
                    && request.resource.data.credits == 0;
    }
    
    // 2. Audit Logs & Reviews (Highly Restricted)
    match /audit_logs/{logId} {
      allow read, create: if hasAdminClaim();
      allow update, delete: if false; // Immutable
    }

    match /sharia_reviews/{reviewId} {
      allow read: if hasAdminClaim() || (isAuthenticated() && resource.data.reviewerId == request.auth.uid) || isOwner(resource.data.authorId);
      allow create, update: if hasAdminClaim() || (isAuthenticated() && request.auth.token.role == 'REVIEWER');
      allow delete: if false;
    }

    // 3. Workspaces & Projects
    match /workspaces/{workspaceId} {
      allow read: if hasWorkspaceRole(workspaceId, ['OWNER', 'MANAGER', 'EDITOR', 'REVIEWER', 'VIEWER']);
      allow create: if isAuthenticated();
      allow update: if hasWorkspaceRole(workspaceId, ['OWNER', 'MANAGER']);
      allow delete: if hasWorkspaceRole(workspaceId, ['OWNER']);
    }
    
    match /workspace_members/{memberId} {
      allow read: if isOwner(resource.data.userId) || hasWorkspaceRole(resource.data.workspaceId, ['OWNER', 'MANAGER', 'EDITOR', 'REVIEWER', 'VIEWER']);
      allow create: if hasWorkspaceRole(request.resource.data.workspaceId, ['OWNER', 'MANAGER']);
      allow update: if hasWorkspaceRole(resource.data.workspaceId, ['OWNER']) || (hasWorkspaceRole(resource.data.workspaceId, ['MANAGER']) && request.resource.data.role != 'OWNER' && resource.data.role != 'OWNER');
      allow delete: if hasWorkspaceRole(resource.data.workspaceId, ['OWNER']) || (hasWorkspaceRole(resource.data.workspaceId, ['MANAGER']) && resource.data.role != 'OWNER') || isOwner(resource.data.userId);
    }
    
    match /projects/{projectId} {
      allow read: if hasWorkspaceRole(resource.data.workspaceId, ['OWNER', 'MANAGER', 'EDITOR', 'REVIEWER', 'VIEWER']);
      allow create: if hasWorkspaceRole(request.resource.data.workspaceId, ['OWNER', 'MANAGER', 'EDITOR']);
      allow update: if hasWorkspaceRole(resource.data.workspaceId, ['OWNER', 'MANAGER', 'EDITOR']);
      allow delete: if hasWorkspaceRole(resource.data.workspaceId, ['OWNER', 'MANAGER']);
    }
    
    // 4. Content (Flashes, Audio, etc)
    match /flashes/{flashId} {
      // General read only if approved and public
      allow read: if (resource.data.status == 'APPROVED' && resource.data.isPrivate == false) || isOwner(resource.data.authorId) || hasAdminClaim();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isOwner(resource.data.authorId) || hasAdminClaim();
      allow delete: if hasAdminClaim(); // Soft delete via update by user
    }
    
    match /audio/{audioId} {
      allow read: if (resource.data.status == 'APPROVED' && resource.data.isPrivate == false) || isOwner(resource.data.authorId) || hasAdminClaim();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isOwner(resource.data.authorId) || hasAdminClaim();
      allow delete: if hasAdminClaim();
    }

    match /templates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if hasAdminClaim();
    }
    
    // 5. Community & Safety
    match /interactions/{interactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || hasAdminClaim();
    }
    
    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read, update: if hasAdminClaim();
      allow delete: if false;
    }

    // 6. Privacy & User Rights
    match /account_deletion_requests/{userId} {
      allow read, create, update, delete: if isOwner(userId) || hasAdminClaim();
    }

    match /data_correction_requests/{requestId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || hasAdminClaim());
      allow update, delete: if hasAdminClaim();
    }

    match /activity_history/{historyId} {
      allow read, create, update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || hasAdminClaim());
    }

    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || hasAdminClaim());
      allow write: if hasAdminClaim();
    }

    // 7. Beta Tester Distribution, Journeys & Surveys
    match /beta_feedback/{feedbackId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || hasAdminClaim());
      allow update, delete: if hasAdminClaim();
    }

    match /beta_testers/{testerId} {
      allow read, create, update: if isAuthenticated() && (request.auth.uid == testerId || hasAdminClaim());
      allow delete: if hasAdminClaim();
    }

    match /beta_experience_surveys/{surveyId} {
      allow create: if isAuthenticated() && request.resource.data.testerId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.testerId == request.auth.uid || hasAdminClaim());
      allow update, delete: if hasAdminClaim();
    }

    // 8. Beta Defect Triage & Defect Records
    match /beta_defects/{defectId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if hasAdminClaim();
    }

    // 9. Backup Snapshots, Disaster Recovery Logs & Restore Jobs (Highly Restricted)
    match /backup_snapshots/{snapshotId} {
      allow read, write: if hasAdminClaim();
    }

    match /backup_logs/{logId} {
      allow read, create: if hasAdminClaim();
      allow update, delete: if false; // Immutable audit trail
    }

    match /restore_jobs/{jobId} {
      allow read, write: if hasAdminClaim();
    }

    // 10. System Health Monitoring, Probes & Incidents
    match /system_health_probes/{probeId} {
      allow read, write: if hasAdminClaim();
    }

    match /service_incidents/{incidentId} {
      allow read: if isAuthenticated();
      allow write: if hasAdminClaim();
    }

    match /monitoring_alerts/{alertId} {
      allow read, write: if hasAdminClaim();
    }

    // 11. Incident Response, Post-Mortems & Emergency Actions
    match /incident_reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if hasAdminClaim();
    }

    match /emergency_actions/{actionId} {
      allow read, create: if hasAdminClaim();
      allow update, delete: if false; // Immutable emergency audit trail
    }

    match /sharia_corrections/{correctionId} {
      allow read: if isAuthenticated();
      allow write: if hasAdminClaim();
    }

    match /escalation_contacts/{contactId} {
      allow read, write: if hasAdminClaim();
    }
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
