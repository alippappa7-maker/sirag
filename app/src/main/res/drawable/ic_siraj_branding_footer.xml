        android:fillColor="#00000000"
        android:strokeColor="#3AA890"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M87,59 L87,69" />

    <!-- R -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#3AA890"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M95,69 L95,59 L100,59 C102.5,59 104,60.5 104,62.5 C104,64.5 102.5,66 100,66 L95,66 M99,66 L104,69" />

