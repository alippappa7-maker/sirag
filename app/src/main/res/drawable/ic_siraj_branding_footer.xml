<?xml version="1.0" encoding="utf-8"?>
<!-- Branding footer for Android 12+ (API 31+) SplashScreen:
     Displays "سراج" with Islamic crescent emblem and "نورٌ يهديك" subtitle.
     Specifications: 200dp x 80dp container, rendered at screen bottom. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="80dp"
    android:viewportWidth="200"
    android:viewportHeight="80">

    <!-- Decorative Top Accent Line with Emerald Glow -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1A00F0B0"
        android:strokeWidth="1"
        android:pathData="M60,14 L140,14" />

    <!-- Center Diamond Star Accent -->
    <path
        android:fillColor="#FFD700"
        android:pathData="M100,10 L103,14 L100,18 L97,14 Z" />

    <!-- Crescent motif -->
    <path
        android:fillColor="#FFE8C547"
        android:pathData="M100,24 C104,24 107,26.5 107,30 C104,28.5 101,29 99.5,31 C98,33 98.5,35 100,36 C96,36 93,33.5 93,30 C93,26.5 96,24 100,24 Z" />

    <!-- "سراج" Typography (Custom Stylized Arabic Letterforms) -->
    <!-- Sin (س): 3 teeth / curved crests at X ~ 125..145 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFD700"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M142,32 C141,35 138,36 135,36 C132,36 130,34 129,32 C128,34 126,36 123,36 C120,36 118,33 118,30" />

