        android:fillColor="#00000000"
        android:strokeColor="#FFD700"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M118,35 C116,39 113,44 107,46" />

    <!-- Alif (ا): tall vertical stroke at X ~ 103 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFD700"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M103,26 L103,42" />

    <!-- Jim (ج): head bar and sweeping lower curve at X ~ 75..95 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFD700"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M80,31 L95,31 C91,35 88,38 88,41 C88,46 93,48 97,48" />

