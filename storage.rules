rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function hasAdminClaim() {
      return isAuthenticated() && request.auth.token.role in ['ADMIN', 'OWNER'];
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if hasAdminClaim();
    }
    
    match /users/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || hasAdminClaim();
      allow write: if isOwner(userId) || hasAdminClaim();
    }
    
    match /workspaces/{workspaceId}/{allPaths=**} {
      // Relying on backend signed URLs for writes to workspace to enforce limits
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /assets/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if hasAdminClaim();
    }
    
    match /exports/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || hasAdminClaim();
      allow write: if isOwner(userId) || hasAdminClaim();
    }
    
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
